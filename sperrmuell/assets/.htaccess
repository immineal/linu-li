# Vite writes the content hash into the file name here — index-Ct5wqi0O.js
# changes its name whenever its contents change. That is versioning done
# properly, so these files can be held for good, and the site-wide
# "revalidate every script" rule one directory up would only cost a round
# trip that can never find anything.
#
# This does not reach sperrmuell/sw.js: that one sits a level up and keeps
# the root's no-cache, which is the one header a service worker must have.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
