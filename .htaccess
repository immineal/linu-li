# 1. Enable Rewrite Engine
RewriteEngine On

# 2. Force HTTPS (Security)
# If the request is NOT HTTPS, redirect to HTTPS
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2b. One address for the site: www.linu.li -> linu.li
# Both hostnames served the same pages with a 200 and no canonical link,
# which is duplicate content. robots.txt, the sitemap and the README all
# name the bare domain, so that is the one that stays. The pattern only
# matches a host that starts with www, and the target never does, so this
# cannot loop.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 2c. Short addresses for the tools: /qr-creator/ reaches /tools/qr-creator/
# A link that drops the directory still arrives, which is most of them —
# typed from memory, read off a screenshot, or written down years ago.
#
# A redirect rather than serving the page at both: two addresses answering
# 200 with the same page is the duplicate content the rule above exists to
# undo, and the sitemap names one address per tool.
#
# The condition asks the file system whether tools/<name>/ is a directory,
# so nothing has to be listed here and a new tool is reachable the day it
# lands. A root file such as privacy.html fails that test and is left alone,
# as is /tools itself — there is no tools/tools.
RewriteCond %{DOCUMENT_ROOT}/tools/$1 -d
RewriteRule ^([^/]+)/?$ /tools/$1/ [L,R=301]

# 2d. The Sperrmüll map used to live at /sperrmuell/ and now sits with the
# rest of the tools. The rule above already catches the bare address; this
# one carries the paths below it too, so an old link straight to the data
# still lands.
#
# sw.js is deliberately not redirected. Everyone who opened the map before
# the move has a worker registered from that address which answers every
# request in the old scope out of its cache. A service worker script is
# never fetched through a redirect — the browser reads a redirected update
# as a failure and keeps what it has — so the old address goes on serving a
# real script, and that script unregisters the worker. sperrmuell/sw.js says
# the rest.
RewriteCond %{REQUEST_URI} !^/sperrmuell/sw\.js$
RewriteRule ^sperrmuell(?:/(.*))?$ /tools/sperrmuell/$1 [L,R=301]

# 3. Remove trailing slashes (Optional, good for SEO consistency)
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)/$ /$1 [L,R=301]

# 4. Browser Caching (Speed)
# This tells the browser to keep images/CSS in memory so they don't download every time.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    
    # HTML documents - cache for 0 seconds (always check for updates)
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS and JS - see the block below. The year that used to stand here was
    # never paired with the versioning its own comment asked for, so a fix to
    # a tool reached nobody who had visited before.
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    
    # Images/Fonts - cache for 1 year
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 4b. The site's own scripts and stylesheets: kept, but revalidated
# A year of cache and no version in any URL meant a correction shipped on
# Monday reached a returning visitor some time next spring. "no-cache" does
# not mean "do not store" — the browser keeps the file and only asks whether
# it is still current. Measured against app.js (356 KB): the conditional
# answer is 0 bytes and 121 ms, the full one 244 ms, and over HTTP/2 the ten
# files of a tool page ask together.
#
# ExpiresActive Off first, because mod_expires would otherwise still write an
# Expires header a year out next to this one.
<IfModule mod_expires.c>
    <FilesMatch "\.(js|css)$">
        ExpiresActive Off
    </FilesMatch>
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>

    # The service worker is the one file that must never be held back: it is
    # what tells the browser that everything else changed. Browsers cap its
    # cache at 24 hours anyway — this makes it none.
    <Files "sw.js">
        Header set Cache-Control "no-cache"
    </Files>

    # The manifest decides what the installed app is called, which icon it
    # wears and where it starts. A month of cache means a corrected name or a
    # new icon sits unseen for weeks on exactly the devices that installed it.
    # Images and fonts keep their year: 121 of them, none versioned, and none
    # that has ever needed to change in a hurry.
    <Files "manifest.json">
        Header set Cache-Control "no-cache"
    </Files>
</IfModule>

<IfModule mod_expires.c>
    <Files "manifest.json">
        ExpiresActive Off
    </Files>
</IfModule>

# The vendored libraries keep the year — assets/vendor/.htaccess says so.
# 6.4 MB of the 7.2 MB total, changed in two commits in the whole history of
# this repository. Revalidating 3.1 MB of mermaid on every page load would
# buy nothing.

# 5. Security Headers
<IfModule mod_headers.c>
    # Prevent site from being embedded in iframes on other sites (clickjacking protection)
    Header always set X-Frame-Options "SAMEORIGIN"
    # Block MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    # Enable XSS protection
    Header always set X-XSS-Protection "1; mode=block"
</IfModule>

# 6. Custom 404 Page
ErrorDocument 404 /index.html